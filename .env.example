EMPIRICAL_PLATFORM_POSTGRES_HOST=localhost
EMPIRICAL_PLATFORM_POSTGRES_PORT=5432
EMPIRICAL_PLATFORM_POSTGRES_DATABASE=empirical_platform
EMPIRICAL_PLATFORM_POSTGRES_USER=empirical
EMPIRICAL_PLATFORM_POSTGRES_PASSWORD=
EMPIRICAL_PLATFORM_POSTGRES_POOL_SIZE=5
EMPIRICAL_PLATFORM_POSTGRES_MAX_OVERFLOW=0
EMPIRICAL_PLATFORM_POSTGRES_CONNECT_TIMEOUT_SECONDS=5
EMPIRICAL_PLATFORM_POSTGRES_APPLICATION_NAME=empirical-platform
EMPIRICAL_PLATFORM_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
EMPIRICAL_PLATFORM_OBJECT_STORAGE_REGION=us-east-1
EMPIRICAL_PLATFORM_OBJECT_STORAGE_BUCKET_PREFIX=empirical-platform-dev
EMPIRICAL_PLATFORM_OBJECT_STORAGE_ACCESS_KEY=
EMPIRICAL_PLATFORM_OBJECT_STORAGE_SECRET_KEY=
EMPIRICAL_PLATFORM_LOCAL_POSTGRES_PASSWORD=
EMPIRICAL_PLATFORM_LOCAL_POSTGRES_PORT=55432
EMPIRICAL_PLATFORM_LOCAL_MINIO_ROOT_USER=
EMPIRICAL_PLATFORM_LOCAL_MINIO_ROOT_PASSWORD=
