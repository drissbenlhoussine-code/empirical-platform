+
+    rows_by_id = {row["governance_id"]: row for row in position_rows}
+    assert rows_by_id["POS-9601"]["status"] == "APPROVED_POSITION_PLAN"
+    assert rows_by_id["POS-9601"]["quantity"] == 1
