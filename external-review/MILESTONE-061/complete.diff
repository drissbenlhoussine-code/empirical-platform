+                "WHERE backtest_run_runtime_id = :runtime_id "
+                "ORDER BY trade_sequence",
+                {"runtime_id": str(identity.runtime_id)},
+            )
+        trades = tuple(_row_to_trade(row) for row in trade_rows)
+        return _row_to_run(run_rows[0], trades)
